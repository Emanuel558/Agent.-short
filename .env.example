# Demo needs no API key, payment, or model installation.
AI_PROVIDER=demo
DATABASE_PATH=./data/autotube.sqlite
# Codespaces port 3000 is detected automatically from its server environment.
# Only for a different forwarded port or a custom reverse proxy: set the exact
# browser origin (no path, wildcard, or list), then restart Next.js.
# APP_ORIGIN=https://your-codespace-name-3000.app.github.dev
# Optional OpenAI-compatible chat-completions server (e.g. self-hosted Ollama).
# No automatic demo fallback on provider failure.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2
# AI_API_KEY=
